<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: registers the DebugBridgeReceiver so an automation agent can drive the app
     over `adb shell am broadcast` (send messages, read state). The manifest merger folds this in for
     debug variants only, so neither the receiver nor this entry ships in a release build. Exported so
     the `shell` uid (adb) can deliver to it; debug-only, so an exported custom-action receiver is fine.

     usesCleartextTraffic is the bench affordance for the spool (Internet-relay) plane: knit-spool
     terminates no TLS of its own (that is a reverse-proxy job), so a LAN daemon is reachable only over
     plain `ws://`. DEBUG BUILDS ONLY — `staging` inherits `release`, has no source-set overlay here, and
     the dialer itself refuses any non-`wss://` URL unless BuildConfig.DEBUG, so no shipped artifact can
     be pointed at a plaintext relay however its settings are edited. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <receiver
            android:name="app.swarsetu.debug.DebugBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.swarsetu.debug.SEND" />
                <action android:name="app.swarsetu.debug.SENDIMG" />
                <action android:name="app.swarsetu.debug.STATE" />
                <action android:name="app.swarsetu.debug.STORE" />
                <action android:name="app.swarsetu.debug.REACT" />
                <action android:name="app.swarsetu.debug.TYPING" />
                <action android:name="app.swarsetu.debug.SHAREAPK" />
                <action android:name="app.swarsetu.debug.HEAL" />
                <action android:name="app.swarsetu.debug.WEBPPROBE" />
                <action android:name="app.swarsetu.debug.WEBPCONV" />
                <action android:name="app.swarsetu.debug.WEBPCHECK" />
                <action android:name="app.swarsetu.debug.REQNOTIF" />
                <action android:name="app.swarsetu.debug.FLAGMSG" />
                <action android:name="app.swarsetu.debug.MKGROUP" />
                <action android:name="app.swarsetu.debug.REVIEW" />
                <action android:name="app.swarsetu.debug.SPOOL" />
                <action android:name="app.swarsetu.debug.RATCHET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
